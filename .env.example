# Environment variables for B.L.U.E.
# Copy this file to `.env` and fill in your real values before running.

# Neon Postgres connection string (replace with your own Neon project URL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-long-random-secret-here"

# NextAuth URL — the public URL of the deployment
NEXTAUTH_URL="http://localhost:3000"
